#!/usr/bin/env python3
"""Minimal WoW addon installer/updater.

Sources (no CurseForge — it has no open API):
  gh   OWNER/REPO   -> latest GitHub release zip (falls back to source archive)
  wowi ID          -> WoWInterface file id

Usage:
  wowaddon                 # sync everything in the manifest
  wowaddon add gh A/B      # append to manifest, then sync
Manifest: ~/.config/wowaddon/addons.txt  (one "kind ref  # note" per line)
"""
import io, json, os, re, shutil, sys, urllib.request, zipfile

FLAVOR = re.compile(r'[-_](Vanilla|Cata|Mainline|TBC|Wrath|Classic|Mists|Standard|Wotlk)$', re.I)

ADDONS = os.environ.get("WOW_ADDONS", os.path.expanduser(
    "~/.local/share/Steam/steamapps/compatdata/3391668301/pfx/drive_c/"
    "Program Files (x86)/World of Warcraft/_classic_era_/Interface/AddOns"))
MANIFEST = os.path.expanduser("~/.config/wowaddon/addons.txt")
UA = {"User-Agent": "wowaddon"}


def fetch(url):
    return urllib.request.urlopen(urllib.request.Request(url, headers=UA), timeout=60).read()


def gh_url(repo):
    try:
        rel = json.loads(fetch(f"https://api.github.com/repos/{repo}/releases/latest"))
        zips = [a for a in rel.get("assets", []) if a["name"].lower().endswith(".zip")]
        if zips:
            # prefer non-nolib; nudge toward classic/vanilla builds if split
            def score(a):
                n = a["name"].lower()
                return (-5 if "nolib" in n else 0) + (2 if any(
                    k in n for k in ("classic", "vanilla", "era")) else 0)
            return max(zips, key=score)["browser_download_url"], False
    except Exception:
        pass
    # fallback: default-branch source archive (folder gets a -branch suffix)
    info = json.loads(fetch(f"https://api.github.com/repos/{repo}"))
    return f"https://github.com/{repo}/archive/refs/heads/{info['default_branch']}.zip", True


def wowi_url(uid):
    return json.loads(fetch(f"https://api.mmoui.com/v3/game/WOW/filedetails/{uid}.json"))[0]["UIDownload"]


def install(kind, ref):
    if kind == "gh":
        url, is_src = gh_url(ref)
    elif kind == "wowi":
        url, is_src = wowi_url(ref), False
    else:
        raise RuntimeError(f"unknown source '{kind}'")
    z = zipfile.ZipFile(io.BytesIO(fetch(url)))
    tops = sorted({n.split("/")[0] for n in z.namelist() if "/" in n})
    if is_src and len(tops) == 1:
        # repo source archive: "REPO-branch/..."
        wrapper = tops[0]
        names = [n[len(wrapper) + 1:] for n in z.namelist() if n.startswith(wrapper + "/")]
        root_tocs = [f for f in names if "/" not in f and f.lower().endswith(".toc")]
        if root_tocs:
            # addon lives at repo root -> install the whole thing as AddOns/<name>/
            name = min((FLAVOR.sub("", t[:-4]) for t in root_tocs), key=len)
            dst_root = os.path.join(ADDONS, name)
            shutil.rmtree(dst_root, ignore_errors=True)
            for m in z.infolist():
                if not m.filename.startswith(wrapper + "/"):
                    continue
                rel = m.filename[len(wrapper) + 1:]
                if not rel:
                    continue
                dst = os.path.join(dst_root, rel)
                if m.is_dir():
                    os.makedirs(dst, exist_ok=True)
                else:
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    open(dst, "wb").write(z.read(m))
            return name
        # repo holds multiple addon folders
        inner = sorted({p.split("/")[0] for p in names if "/" in p and p.split("/")[0]})
        for t in inner:
            shutil.rmtree(os.path.join(ADDONS, t), ignore_errors=True)
        for m in z.infolist():
            parts = m.filename.split("/", 1)
            if len(parts) == 2 and parts[1]:
                dst = os.path.join(ADDONS, parts[1])
                if m.is_dir():
                    os.makedirs(dst, exist_ok=True)
                else:
                    os.makedirs(os.path.dirname(dst), exist_ok=True)
                    open(dst, "wb").write(z.read(m))
        return ", ".join(inner)
    for t in tops:
        shutil.rmtree(os.path.join(ADDONS, t), ignore_errors=True)
    z.extractall(ADDONS)
    return ", ".join(tops)


def manifest():
    if not os.path.exists(MANIFEST):
        return []
    rows = []
    for line in open(MANIFEST):
        line = line.split("#")[0].split()
        if line:
            rows.append(line)
    return rows


def main():
    a = sys.argv[1:]
    if a and a[0] == "add":
        os.makedirs(os.path.dirname(MANIFEST), exist_ok=True)
        open(MANIFEST, "a").write(" ".join(a[1:]) + "\n")
    os.makedirs(ADDONS, exist_ok=True)
    for row in manifest():
        kind, ref = row[0], row[1]
        try:
            print(f"OK   {kind}:{ref} -> {install(kind, ref)}")
        except Exception as e:
            print(f"FAIL {kind}:{ref} -> {e}")


if __name__ == "__main__":
    main()
