{
  "name": "wowaddon",
  "version": "2.3.5",
  "description": "Agent-friendly CLI and TUI that installs and updates WoW addons from GitHub, CurseForge, WoWInterface, Tukui and Wago Addons",
  "license": "MIT",
  "repository": "github:cjber/wowaddon",
  "private": true,
  "type": "module",
  "bin": {
    "wowaddon": "bin/wowaddon"
  },
  "scripts": {
    "start": "bun run src/index.tsx",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun test",
    "gate:changed": "scripts/gate-changed.sh",
    "gate": "bun run check && bun run build && bun scripts/changelog.ts --check",
    "build": "bun scripts/build.ts"
  },
  "dependencies": {
    "@opentui/core": "0.9.0",
    "@opentui/react": "0.9.0",
    "@zip.js/zip.js": "2.25.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.4",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
